{
	// Copy this file to config.hujson next to the binary and uncomment
	// what you need. Every value here is the built-in default, so an
	// absent or empty config.hujson is a valid config.

	// Address the HTTP server listens on.
	// "Addr": ":8080",

	// Origins allowed to open a WebSocket. Empty means same-origin only;
	// "*" disables the check entirely (do not do that in production).
	// "AllowedOrigins": [],

	// Messages the shared fan-out buffer holds, and so how far behind a
	// client may fall before it is disconnected. Size it for the lag
	// spread, not the average (see README). 8 bytes a slot per channel per
	// codec: 16384 is 256KB for a channel on both, 256MB at MaxChannels.
	// "Capacity": 16384,

	// How many frames a connection's write pump takes per wakeup.
	// "WriteBatch": 16,

	// The largest frame the server will read from a client, in bytes.
	// "MaxFrameSize": 32768,

	// The longest chat message body accepted, in bytes.
	// "MaxMessage": 512,

	// The channel an empty channel name means, and the one a connection
	// joins when nothing says otherwise.
	// "DefaultChannel": "main",

	// How many channels may exist at once, and how many one connection may
	// be in. Channels are created by whoever joins one, so without a cap a
	// client can invent them until the server runs out of memory.
	// "MaxChannels": 1024,
	// "MaxChannelsPerConn": 32,

	// How many recent messages a connecting client is sent. 0 disables it.
	// "Backlog": 50,

	// Combining marks allowed in a row before a message is refused as
	// zalgo; 0 disables. Five clears every script that stacks them.
	// "MaxDiacritics": 5,

	// Private messages queued for one client before further ones are
	// refused with ERR recipientbusy.
	// "PrivBuffer": 32,

	// Bounds one wakeup's worth of socket writes, so a client that stops
	// reading cannot wedge the goroutine writing to it.
	// "WriteTimeout": "10s",

	// Closes a connection that has sent nothing, not even a PING, for this
	// long. Clients are expected to ping.
	// "IdleTimeout": "90s",

	// Where /metrics and /debug/pprof/ are served; empty binds nothing.
	// pprof has no authentication, so keep this off public interfaces.
	// "DebugAddr": "127.0.0.1:6060",

	// Log level: debug, info, warn, error.
	// "LogLevel": "info",
}
