{
	// Copy this file to config.hujson next to the binary and uncomment
	// what you need. Every value here is the built-in default, so an
	// absent or empty config.hujson is a valid config.
	//
	// config_test.go loads this file and checks it against the defaults in
	// code, so the two cannot drift apart.

	// Address the HTTP server listens on.
	// "Addr": ":8080",

	// Origins allowed to open a WebSocket. Empty means same-origin only;
	// "*" disables the check entirely (do not do that in production).
	// "AllowedOrigins": [],

	// How many messages the shared fan-out buffer holds. It doubles as the
	// lag threshold: a client that falls this far behind is disconnected
	// rather than waited on.
	//
	// Size it for the lag spread, not the average: one straggler thousands
	// of messages behind is what decides whether anything is dropped. The
	// buffer is shared, so this is 16 bytes a slot for the whole server,
	// not per client — 4096 slots is 64KB however many people are here.
	// "Capacity": 4096,

	// How many frames a connection's write pump takes per wakeup. Larger
	// means fewer wakeups for a client that has fallen behind.
	// "WriteBatch": 16,

	// The largest frame the server will read from a client, in bytes.
	// "MaxFrameSize": 32768,

	// The longest chat message body accepted, in bytes.
	// "MaxMessage": 512,

	// How many recent messages a connecting client is sent, so it arrives
	// with context instead of an empty window. 0 disables the backlog.
	// "Backlog": 50,

	// How many combining marks may be stacked on one character before a
	// message is refused as zalgo. 0 disables the filter. Five is well
	// clear of scripts that stack marks legitimately.
	// "MaxDiacritics": 5,

	// How many private messages may be queued for one client before
	// further ones are refused with ERR recipientbusy.
	// "PrivBuffer": 32,

	// Bounds a single socket write. Without it a client that stops reading
	// wedges whatever goroutine is writing to it.
	// "WriteTimeout": "10s",

	// Closes a connection that has sent nothing at all — not even a PING —
	// for this long. Clients are expected to ping.
	// "IdleTimeout": "90s",

	// Where profiling and metrics are served: /metrics and /debug/pprof/.
	// Empty disables them and binds nothing.
	//
	// Loopback by default, and think before changing it. pprof has no
	// authentication: /debug/pprof/heap hands out everything in memory and
	// /debug/pprof/profile lets anyone pin a core for thirty seconds.
	// "DebugAddr": "127.0.0.1:6060",

	// Log level: debug, info, warn, error.
	// "LogLevel": "info",
}
